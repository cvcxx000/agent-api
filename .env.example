# 无需安装任何第三方依赖，python3 run.py 直接启动
# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
# 全局管理员钥匙：脚本 / 终端用，设置后等于一把万能钥匙（可留空）
API_TOKEN=

# ===== 账号与登录 =====
# on（默认）：强制登录；没账号时第一次打开就是「创建第一个账号」
# auto：没有账号、也没设 API_TOKEN 时开放；建了账号才要求登录
# off：关掉账号体系（等于回到「谁打开都能用」）
AUTH_MODE=on
# personal 自己用 / merchant 卖订阅；留空则第一次打开时在网页里选
# DEPLOY_MODE=merchant
GUEST_ENABLED=1
GUEST_TTL_HOURS=24
GUEST_QUOTA_MB=100
GUEST_RATE_SECONDS=60
# Google OAuth 的重定向基地址，默认 http://127.0.0.1:当前端口
# 用域名 / 反代时改成 https://你的域名（Google 只认 127.0.0.1 的 http）
# AUTH_BASE_URL=https://agent.example.com

# ===== 大模型（任意 OpenAI 兼容接口）=====
# OpenAI:  https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# 通义:     https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
# auto: 没 Key 时自动用 MockLLM 联调；true/false 可强制
LLM_MOCK=auto

# ===== Agent 行为 =====
AGENT_MAX_TURNS=16
AGENT_HISTORY_LIMIT=80
# 子 Agent 并发上限：需求要求 3，不要超过
AGENT_MAX_SUBAGENTS=3
# 子 Agent 嵌套层数：1 表示子 Agent 不能再派子 Agent
AGENT_MAX_SUBAGENT_DEPTH=1
MAX_TOOL_OUTPUT_CHARS=20000

# ===== 上游限速 =====
# 每分钟最多向模型发多少次请求（0 = 不限速）。所有子 Agent 共用这个配额。
# 测试 Key 若只给 7 次/分钟，就保持 7；正常 Key 可以调大或设 0。
RATE_LIMIT_PER_MIN=7

# ===== 代码执行 =====
# 两个都默认开：run_python 和 run_shell 同权（都在沙箱目录里跑）。
# 只想给 Python 就把 ENABLE_SHELL 改成 false。
ENABLE_PYTHON=true
ENABLE_SHELL=true
PYTHON_TIMEOUT=60
SHELL_TIMEOUT=60

# ===== 目录 =====
SANDBOX_ROOT=./workspace
DATA_DIR=./data
SKILLS_DIRS=./skills,./workspace/.skills
# 工作流目录（JSON 格式）
WORKFLOWS_DIR=./workflows

# 可选：直接覆盖默认系统提示词
# SYSTEM_PROMPT=
# SYSTEM_PROMPT_FILE=

LOG_LEVEL=INFO

# 流式请求里带 stream_options.include_usage，才能拿到 token 用量和缓存命中率（默认 1）
LLM_STREAM_USAGE=1
